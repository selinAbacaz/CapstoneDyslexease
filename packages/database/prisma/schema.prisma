// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgres"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model User {
  user_cuid          String   @id @default(cuid())
  username           String   @unique
  email              String   @unique
  password_hash      String
  refresh_token_hash String?
  created_at         DateTime @default(now())
  modified_at        DateTime @updatedAt
  file               File[]
}

model FilePreference {
  file_pref_cuid       String       @id @default(cuid())
  file_cuid            String       @unique
  text_color_hex       String?
  background_color_hex String?
  text_spacing         Int?
  font_size            Int?
  created_at           DateTime     @default(now())
  modified_at          DateTime     @updatedAt
  file                 File         @relation(references: [file_cuid], fields: [file_cuid])
  letterSwaps          LetterSwap[]
}

model LetterSwap {
  letter_swap_cuid String         @id @default(cuid())
  file_pref_cuid   String
  letter1          String         @db.Char(1)
  letter2          String         @db.Char(1)
  created_at       DateTime       @default(now())
  modified_at      DateTime       @updatedAt
  file_pref        FilePreference @relation(fields: [file_pref_cuid], references: [file_pref_cuid])
}

model File {
  file_cuid      String          @id @default(cuid())
  user_cuid      String
  file_name      String
  file_type      String?
  file_link      String?
  extracted_text String          @default("")
  created_at     DateTime        @default(now())
  modified_at    DateTime        @updatedAt
  users          User            @relation(fields: [user_cuid], references: [user_cuid])
  file_pref      FilePreference?
}
